# Copier vers `.env` (développement) ou renseigner les variables CI pour la prod.

# local | staging | production
VITE_APP_ENV=local

# API NestJS Quizzback
# Local : lancer le backend sur http://localhost:3000
VITE_API_URL=http://localhost:3000/api/v1

# Production :
# VITE_APP_ENV=production
# VITE_API_URL=https://quizz-p4ze.onrender.com/api/v1

# Lecture catalogue (catégories / questions) — optionnel, même contrat que le mobile.
# Sans ces clés, l’app utilise un catalogue de démonstration.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# ── Passkeys / WebAuthn ──────────────────────────────────────────────
# Le backend est configuré avec :
#   WEBAUTHN_RP_ID=quizz-p4ze.onrender.com
#   WEBAUTHN_ORIGIN=https://quizz-p4ze.onrender.com
#
# En local, les passkeys ne fonctionnent que si le backend accepte l’origine
# de Vite (http://localhost:5173) et un RP ID compatible (souvent `localhost`).
# En production, héberger ce PWA sur un domaine lié au RP ID
# (idéalement sous quizz-p4ze.onrender.com).
