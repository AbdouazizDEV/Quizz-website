# Copier vers `.env` (développement) ou renseigner les variables CI pour la prod.

# local | staging | production
VITE_APP_ENV=local

# API NestJS Quizzback
# Local : lancer le backend sur http://localhost:3000
VITE_API_URL=http://localhost:3000/api/v1

# Production :
# VITE_APP_ENV=production
# VITE_API_URL=https://api.quizzp.com/api/v1

# Lecture catalogue (catégories / questions) — optionnel, même contrat que le mobile.
# Sans ces clés, l’app utilise un catalogue de démonstration.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# ── Auth web ─────────────────────────────────────────────────────────
# Le site web utilise e-mail/pseudo + mot de passe
# (POST /auth/login, POST /auth/register).
#
# Google Sign-In (@react-oauth/google → POST /auth/google/token)
VITE_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
#
# ── Passkeys / WebAuthn (mobile uniquement) ───────────────────────────
# Réservées à QuizzMobile. Le flux web principal n’appelle plus WebAuthn.
# Backend (référence mobile) :
#   WEBAUTHN_RP_ID=quizzp.com
#   WEBAUTHN_ORIGIN=https://quizzp.com,https://www.quizzp.com
